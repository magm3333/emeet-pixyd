package main

import (
	"fmt"
	"strconv"

	"github.com/LarsArtmann/emeet-pixyd/internal/pixy"
)

//go:generate templ generate

// ---------------------------------------------------------------------------
// Icons (inline SVG, Lucide-style stroke icons)
// ---------------------------------------------------------------------------
templ iconLens() {
	<svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
		<circle cx="12" cy="12" r="10"></circle>
		<circle cx="12" cy="12" r="4.5"></circle>
		<circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"></circle>
	</svg>
}

templ iconTarget() {
	<svg class="mode-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
		<circle cx="12" cy="12" r="8"></circle>
		<circle cx="12" cy="12" r="3"></circle>
		<line x1="12" y1="2" x2="12" y2="5"></line>
		<line x1="12" y1="19" x2="12" y2="22"></line>
		<line x1="2" y1="12" x2="5" y2="12"></line>
		<line x1="19" y1="12" x2="22" y2="12"></line>
	</svg>
}

templ iconStandby() {
	<svg class="mode-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
		<circle cx="12" cy="12" r="8"></circle>
		<path d="M12 7.5v4.5"></path>
		<circle cx="12" cy="16" r="0.6" fill="currentColor" stroke="none"></circle>
	</svg>
}

templ iconPush() {
	<svg class="chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
		<path d="m17 8-5-5-5 5"></path>
		<path d="M12 3v12"></path>
	</svg>
}

templ iconEyeOff() {
	<svg class="mode-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
		<path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c5 0 9 5 9 7a13.16 13.16 0 0 1-1.67 2.68"></path>
		<path d="M6.61 6.61A13.526 13.526 0 0 0 3 12c0 2 4 7 9 7a9.74 9.74 0 0 0 5.39-1.61"></path>
		<line x1="3" y1="3" x2="21" y2="21"></line>
	</svg>
}

templ iconCamera() {
	<svg class="snap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
		<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3l2-3h8l2 3h3a2 2 0 0 1 2 2z"></path>
		<circle cx="12" cy="13" r="4"></circle>
	</svg>
}

templ iconCameraOff() {
	<svg class="placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
		<path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3l2-3h8l2 3h3a2 2 0 0 1 2 2z"></path>
		<circle cx="12" cy="13" r="4"></circle>
		<line x1="3" y1="3" x2="21" y2="21"></line>
	</svg>
}

// ---------------------------------------------------------------------------
// Page
// ---------------------------------------------------------------------------
templ page(s webStatus) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover"/>
			<meta name="color-scheme" content="dark"/>
			<meta name="theme-color" content="#0a0c10"/>
			<meta name="description" content="Control panel for the EMEET PIXY dual-camera AI webcam"/>
			<title>EMEET PIXY — { s.Camera }</title>
			<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%235b8def' stroke-width='1.5'%3E%3Ccircle cx='12' cy='12' r='10'/%3E%3Ccircle cx='12' cy='12' r='4.5'/%3E%3Ccircle cx='12' cy='12' r='1.5' fill='%235b8def' stroke='none'/%3E%3C/svg%3E"/>
			<link rel="stylesheet" href={ fmt.Sprintf("/static/style.css?v=%s&revision=rtsp-ui-10", s.Version) }/>
		</head>
		<body data-init="@get('/api/events', {openWhenHidden: true})">
			<main class="container">
				<header>
					<div class="brand">
						@iconLens()
						<h1>EMEET PIXY</h1>
					</div>
					<div class="header-meta">
						<button class="lang-toggle" id="lang-toggle" type="button" aria-label="Switch language / Cambiar idioma">
							<span id="lang-toggle-label">ES</span>
						</button>
						<span class="sse-indicator" id="sse-indicator" role="status" aria-label="Live updates connecting"></span>
						if s.Online {
							<span class="header-badge header-badge-online" data-i18n="status.online">Online</span>
						} else {
							<span class="header-badge header-badge-offline" data-i18n="status.offline">Offline</span>
						}
					</div>
				</header>
				<div id="offline-banner" class="offline-banner" style="display:none" role="alert">
					<span class="offline-dot"></span>
					<span data-i18n="status.reconnecting">Connection lost — reconnecting…</span>
				</div>
				<section class="preview-wrap">
					<div class="preview-container" id="preview">
						if s.Online && s.Device != "" {
							<img src="/api/stream" id="preview-img" alt="Live camera feed" aria-label="Live camera preview" aria-describedby="preview-mouse-help" draggable="false"/>
							<div class="coverage-widget" id="coverage-widget">
								<button class="coverage-toggle" id="coverage-toggle" type="button" role="switch" aria-checked="false" aria-controls="coverage-visual">
									<span class="coverage-toggle-label" data-i18n="preview.coverageToggle">Esfera</span>
									<span class="coverage-switch-track" aria-hidden="true"><span class="coverage-switch-thumb"></span></span>
								</button>
								<div class="coverage-visual" id="coverage-visual" hidden>
									<button class="coverage-eye" id="coverage-eye" type="button" aria-label="Ocultar esfera" data-i18n-aria-label="preview.coverageHide">
										<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
											<path d="M2.2 12s3.4-6.2 9.8-6.2 9.8 6.2 9.8 6.2-3.4 6.2-9.8 6.2S2.2 12 2.2 12Z"></path>
											<circle cx="12" cy="12" r="2.7"></circle>
										</svg>
									</button>
									<canvas class="coverage-canvas" id="coverage-canvas" width="360" height="360" tabindex="0" role="application" aria-label="Esfera interactiva; arrastra o usa las flechas para mover la cámara" data-i18n-aria-label="preview.coverageDescription" aria-describedby="coverage-readout"></canvas>
									<div class="coverage-readout" id="coverage-readout"></div>
									<div class="coverage-range" data-i18n="preview.coverageRange">Alcance PTZ · 300° × 180°</div>
								</div>
							</div>
							if s.Controllable {
								<div class="mobile-ptz-controls" id="mobile-ptz-controls" role="group" aria-label="Controles táctiles PTZ" data-i18n-aria-label="mobile.controlsLabel">
									<div class="mobile-ptz-dpad" role="group" aria-label="Pan y tilt" data-i18n-aria-label="mobile.dpadLabel">
										<span class="mobile-ptz-spacer" aria-hidden="true"></span>
										<button class="mobile-ptz-button" type="button" data-mobile-ptz-axis="tilt" data-mobile-ptz-step="1" aria-label="Inclinar hacia arriba" data-i18n-aria-label="mobile.tiltUp">↑</button>
										<span class="mobile-ptz-spacer" aria-hidden="true"></span>
										<button class="mobile-ptz-button" type="button" data-mobile-ptz-axis="pan" data-mobile-ptz-step="-1" aria-label="Mover a la izquierda" data-i18n-aria-label="mobile.panLeft">←</button>
										<span class="mobile-ptz-center" aria-hidden="true"></span>
										<button class="mobile-ptz-button" type="button" data-mobile-ptz-axis="pan" data-mobile-ptz-step="1" aria-label="Mover a la derecha" data-i18n-aria-label="mobile.panRight">→</button>
										<span class="mobile-ptz-spacer" aria-hidden="true"></span>
										<button class="mobile-ptz-button" type="button" data-mobile-ptz-axis="tilt" data-mobile-ptz-step="-1" aria-label="Inclinar hacia abajo" data-i18n-aria-label="mobile.tiltDown">↓</button>
										<span class="mobile-ptz-spacer" aria-hidden="true"></span>
									</div>
									<div class="mobile-zoom-controls" role="group" aria-label="Zoom" data-i18n-aria-label="mobile.zoomLabel">
										<button class="mobile-ptz-button mobile-zoom-button" type="button" data-mobile-ptz-axis="zoom" data-mobile-ptz-step="10" aria-label="Acercar" data-i18n-aria-label="mobile.zoomIn">+</button>
										<button class="mobile-ptz-button mobile-zoom-button" type="button" data-mobile-ptz-axis="zoom" data-mobile-ptz-step="-10" aria-label="Alejar" data-i18n-aria-label="mobile.zoomOut">−</button>
									</div>
								</div>
								@mobileCameraModeControls(s)
							}
							<div id="preview-fallback" class="preview-placeholder" style="display:none;position:absolute;inset:0;align-items:center;justify-content:center;flex-direction:column">
								@iconCameraOff()
								<div data-i18n="preview.unavailable">Camera in use or unavailable</div>
							</div>
							<button class="preview-snapshot" id="snapshot-btn" type="button" aria-label="Take snapshot">
								@iconCamera()
								<span data-i18n="preview.snapshot">Snapshot</span>
							</button>
						} else {
							<div class="preview-placeholder">
								@iconCameraOff()
								<div data-i18n="preview.offline">Camera offline</div>
							</div>
						}
					</div>
					@previewResolution(s)
					if s.Online && s.Device != "" {
						<p class="preview-help" id="preview-mouse-help" data-i18n="preview.mouseHelp">
							Controles con mouse: arrastrá el video; derecha = pan positivo, izquierda = pan negativo, arriba = tilt positivo y abajo = tilt negativo (aprox. 1° cada 4 px). Doble clic: zoom +10; clic derecho: zoom −10. Los sliders de posición se actualizan con cada movimiento.
						</p>
					}
					@routeSection(s)
				</section>
				@statusPanel(s)
				@rtspPanel(s)
			</main>
			@shortcutLegend()
			<button class="shortcut-fab" id="shortcut-fab" type="button" aria-label="Show keyboard shortcuts">?</button>
			<div id="toast-container"></div>
			<script type="module" src="/static/datastar.js"></script>
			<script src={ fmt.Sprintf("/static/app.js?v=%s&revision=rtsp-ui-10", s.Version) }></script>
			<script src={ fmt.Sprintf("/static/i18n.js?v=%s&revision=rtsp-ui-10", s.Version) }></script>
		</body>
	</html>
}

templ previewResolution(s webStatus) {
	if s.Online && s.Device != "" {
		<div class="preview-resolution" id="preview-resolution">
			<label for="capture-mode-select" data-i18n="preview.resolutionLabel">Resolución y FPS</label>
			<select id="capture-mode-select" data-current={ s.CaptureMode.ID } aria-describedby="capture-mode-help"
				if s.RTSPPublishing {
					disabled=""
				}
			>
				for _, mode := range s.CaptureModes {
					if mode.ID == s.CaptureMode.ID {
						<option value={ mode.ID } selected>{ mode.Label }</option>
					} else {
						<option value={ mode.ID }>{ mode.Label }</option>
					}
				}
			</select>
			<p id="capture-mode-help" aria-live="polite">
				if s.CaptureMode.ZoomAvailable {
					<span data-i18n="preview.zoomAvailable">Zoom digital disponible hasta 1,5×. Cambiar el modo reinicia el stream.</span>
				} else {
					<span data-i18n="preview.zoomUnavailable">Zoom digital no disponible en este modo. Cambiar el modo reinicia el stream.</span>
				}
			</p>
		</div>
	} else {
		<div id="preview-resolution"></div>
	}
}

templ mobileCameraModeControls(s webStatus) {
	<div class="mobile-camera-modes" id="mobile-camera-modes" role="group" aria-label="Modo de cámara" data-i18n-aria-label="mobile.modeGroup">
		@mobileCameraModeButton("/api/track", "mobile.modeTrack", "Seguir", s.Camera == pixy.StateTracking, s.Controllable && !s.RouteBusy)
		@mobileCameraModeButton("/api/idle", "mobile.modeIdle", "Pausa", s.Camera == pixy.StateIdle, s.Controllable && !s.RouteBusy)
		@mobileCameraModeButton("/api/privacy", "mobile.modePrivacy", "Privacidad", s.Camera == pixy.StatePrivacy, s.Controllable && !s.RouteBusy)
	</div>
}

templ mobileCameraModeButton(endpoint, key, label string, active, enabled bool) {
	<button
		class={ "mobile-mode-button", templ.KV("active", active) }
		type="button"
		data-on:click={ fmt.Sprintf("@post('%s')", endpoint) }
		data-indicator="loading"
		data-class:btn-loading="$loading"
		aria-label={ label }
		aria-pressed={ fmt.Sprintf("%t", active) }
		data-i18n={ key }
		data-i18n-aria-label={ key }
		if !enabled {
			disabled=""
		}
	>
		{ label }
	</button>
}

templ rtspPanel(s webStatus) {
<section class="rtsp-panel" id="rtsp-panel" data-signals={ fmt.Sprintf("{rtspUrl:%q}", s.RTSPSavedURL) } aria-labelledby="rtsp-title">
		<div class="rtsp-panel-header">
			<h2 class="rtsp-title" id="rtsp-title" data-i18n="rtsp.title">Publicación RTSP</h2>
		</div>
		<label class="rtsp-url-label" for="rtsp-url-input" data-i18n="rtsp.urlLabel">URL RTSP de destino</label>
		<div class="rtsp-url-row">
			<input
				class="rtsp-url-input"
				id="rtsp-url-input"
				type="password"
				inputmode="url"
				autocomplete="off"
				spellcheck="false"
				data-bind="rtspUrl"
				data-i18n-placeholder="rtsp.urlPlaceholder"
				placeholder="rtsp://servidor:8554/ruta"
				aria-describedby="rtsp-url-hint"
				data-on:keydown="evt.key === 'Enter' && document.getElementById('rtsp-start-btn') && document.getElementById('rtsp-start-btn').click()"
			/>
			<button class="btn btn-small btn-ghost rtsp-url-toggle" id="rtsp-url-toggle" type="button" aria-controls="rtsp-url-input" aria-pressed="false" data-i18n="rtsp.showURL">Mostrar</button>
		</div>
		<p class="rtsp-hint" id="rtsp-url-hint" data-i18n="rtsp.hint">Pega la URL de publicación RTSP. Los datos de usuario no se muestran en el estado ni en los errores.</p>
		@rtspControls(s)
		@rtspStatus(s)
	</section>
}

templ rtspControls(s webStatus) {
	<div class="rtsp-actions" id="rtsp-controls">
		if s.RTSPPublishing {
			<button class="btn btn-small btn-ghost" id="rtsp-pause-btn" type="button" data-on:click="@post('/api/rtsp/stop')" data-i18n="rtsp.pause">Pausar emisión</button>
		} else {
			<button class="btn btn-small" id="rtsp-start-btn" type="button" data-on:click="$rtspUrl.trim() ? @post('/api/rtsp/start') : window.__showToast(window.__i18n('rtsp.urlRequired'), 'error')" data-i18n="rtsp.start">Iniciar emisión</button>
		}
	</div>
}

templ rtspStatus(s webStatus) {
	<div class="rtsp-status" id="rtsp-status" role="status" aria-live="polite" aria-atomic="true">
		<div class="rtsp-status-line">
			<span class={ "rtsp-state-dot", "rtsp-state-" + string(s.RTSPState) } aria-hidden="true"></span>
			switch s.RTSPState {
				case rtspStateStarting:
					<span data-i18n="rtsp.connecting">Conectando…</span>
				case rtspStatePublishing:
					<span data-i18n="rtsp.publishing">Transmitiendo</span>
				case rtspStateStopping:
					<span data-i18n="rtsp.stopping">Pausando…</span>
				case rtspStatePaused:
					<span data-i18n="rtsp.paused">Pausada</span>
				case rtspStateError:
					<span data-i18n="rtsp.error">Error al emitir</span>
				default:
					<span data-i18n="rtsp.stopped">Detenida</span>
			}
			if s.RTSPDestination != "" {
				<code class="rtsp-destination">{ s.RTSPDestination }</code>
			}
		</div>
		if s.RTSPError != "" {
			<p class="rtsp-error" role="alert">{ s.RTSPError }</p>
		}
	</div>
}

// ---------------------------------------------------------------------------
// Status Panel (morphed via DataStar SSE patches by ID)
// ---------------------------------------------------------------------------
templ statusPanel(s webStatus) {
	<div id="status-panel" style="position:relative">
		if s.Error != "" {
			<div class="error-banner" role="alert">{ s.Error }</div>
		}
		if s.InCall {
			<div class="status-strip">
				<span class="status-call-dot"></span>
				In call
			</div>
		}
		<div class="mode-grid">
			@cameraModeCard("track", "/api/track", "Track", "Follows movement", "T", s.Camera == pixy.StateTracking, s.Controllable && !s.RouteBusy)
			@cameraModeCard("idle", "/api/idle", "Idle", "Standing by", "I", s.Camera == pixy.StateIdle, s.Controllable && !s.RouteBusy)
			@cameraModeCard("privacy", "/api/privacy", "Privacy", "Lens covered", "P", s.Camera == pixy.StatePrivacy, s.Controllable && !s.RouteBusy)
		</div>
		if s.Controllable && s.Camera == pixy.StateTracking {
			<div class="segmented tracking-variants" role="group" aria-label="Tracking variant">
				@trackingSegment("none", "None", s.TrackMode == pixy.TrackNone.String())
				@trackingSegment("face", "Face", s.TrackMode == pixy.TrackFace.String())
				@trackingSegment("halfbody", "Half Body", s.TrackMode == pixy.TrackHalfBody.String())
				@trackingSegment("fullbody", "Full Body", s.TrackMode == pixy.TrackFullBody.String())
			</div>
		}
		<div class="controls-grid">
			<div class="controls-col">
				<div class="card">
					<div class="card-title">Audio</div>
					<div class="segmented">
						@audioSegment("nc", "Noise Cancel", s.Audio == pixy.AudioNC, s.Controllable)
						@audioSegment("live", "Live", s.Audio == pixy.AudioLive, s.Controllable)
						@audioSegment("org", "Original", s.Audio == pixy.AudioOriginal, s.Controllable)
					</div>
					<div class="toggle-row audio-monitor-row">
						<div class="toggle-info">
							<span class="toggle-label" id="audio-monitor-label" data-i18n="audio.monitorLabel">Escuchar micrófono</span>
							<span class="toggle-desc" id="audio-monitor-help" data-i18n="audio.monitorHelp">Escucha local de la entrada EMEET PIXY.</span>
							<span class="audio-monitor-status" id="audio-monitor-status" aria-live="polite"></span>
						</div>
						<button class="toggle audio-monitor-toggle" id="audio-monitor-toggle" type="button" role="switch" aria-checked="false" aria-labelledby="audio-monitor-label" aria-describedby="audio-monitor-help" aria-busy="false"></button>
					</div>
				</div>
				<div class="card">
					<div class="card-title">Settings</div>
					<div class="toggle-row">
						<div class="toggle-info">
							<span class="toggle-label" id="gesture-label">Gesture Control</span>
							<span class="toggle-desc">Hand gestures to control camera</span>
						</div>
						<button
							class={ "toggle", templ.KV("on", s.Gesture) }
							data-on:click="@post('/api/gesture')"
							data-indicator="loading"
							data-class:btn-loading="$loading"
							aria-labelledby="gesture-label"
							role="switch"
							aria-checked={ fmt.Sprintf("%t", s.Gesture) }
							if !s.Controllable {
								disabled=""
							}
						></button>
					</div>
					if s.Battery != "" {
						<div class="toggle-row">
							<div class="toggle-info">
								<span class="toggle-label">Battery</span>
								<span class="toggle-desc">{ s.Battery }</span>
							</div>
						</div>
					}
					<div class="toggle-row">
						<div class="toggle-info">
							<span class="toggle-label" id="auto-label">
								Auto Mode
								if !s.Auto.IsOff() {
									<span class="badge-mini">{ s.Auto.String() }</span>
								}
							</span>
							<span class="toggle-desc">Auto-activate in calls</span>
						</div>
						<button
							class={ "toggle", templ.KV("on", !s.Auto.IsOff()) }
							data-on:click="@post('/api/auto')"
							data-indicator="loading"
							data-class:btn-loading="$loading"
							aria-labelledby="auto-label"
							role="switch"
							aria-checked={ fmt.Sprintf("%t", !s.Auto.IsOff()) }
							if !s.Online {
								disabled=""
							}
						></button>
					</div>
				</div>
			</div>
			<div class="controls-col">
				if s.Online {
					<div
						class="card"
						data-signals={ fmt.Sprintf("{pan:%d,tilt:%d,zoom:%d,speedPan:%s,speedTilt:%s,speedZoom:%s,presetName:''}", s.Pan, s.Tilt, s.Zoom, formatSpeed(s.Speeds.Pan), formatSpeed(s.Speeds.Tilt), formatSpeed(s.Speeds.Zoom)) }
					>
						<div class="card-title">Position</div>
						<div class="ptz-layout">
							@ptzRadar(s.Pan, s.Tilt, s.Zoom)
							<div class="ptz-controls">
								@ptzSlider("Pan", "pan", pixy.PanRange.Min, pixy.PanRange.Max, s.Pan, "°")
								@ptzSlider("Tilt", "tilt", pixy.TiltRange.Min, pixy.TiltRange.Max, s.Tilt, "°")
								@ptzSlider("Zoom", "zoom", pixy.ZoomRange.Min, pixy.ZoomRange.Max, s.Zoom, "x")
							</div>
						</div>
						<div class="spacer"></div>
						<div class="speed-block">
							<div class="card-title">Speed <span class="badge-mini">HID</span></div>
							<div class="ptz-controls">
								@speedSlider("Pan", "pan", "speedPan", formatSpeed(s.Speeds.Pan))
								@speedSlider("Tilt", "tilt", "speedTilt", formatSpeed(s.Speeds.Tilt))
								@speedSlider("Zoom", "zoom", "speedZoom", formatSpeed(s.Speeds.Zoom))
							</div>
						</div>
						<div class="spacer"></div>
						<button class="btn" data-on:click="@post('/api/center')" data-indicator="loading" data-class:btn-loading="$loading" aria-label="Center camera">Center<span class="kbd">C</span></button>
						@presetSection(s.PresetNames)
					</div>
				} else {
					<div class="card card-muted">
						<div class="card-title">Position</div>
						<div class="card-empty">Connect device to control position</div>
					</div>
				}
			</div>
		</div>
		<div class="footer-bar">
			<div class="footer-actions">
				<button class="btn btn-ghost" data-on:click="@post('/api/sync')" data-indicator="loading" data-class:btn-loading="$loading" aria-label="Sync state">Sync</button>
				<button class="btn btn-ghost" data-on:click="@post('/api/probe')" data-indicator="loading" data-class:btn-loading="$loading" aria-label="Probe devices">Probe</button>
			</div>
			if s.Model != "" {
				<span class="last-synced footer-model">{ s.Model }</span>
			}
			if s.LastSynced != "" {
				<span class="last-synced">Last synced { s.LastSynced } · v{ s.Version }</span>
			} else if s.Version != "" {
				<span class="last-synced">v{ s.Version }</span>
			}
		</div>
	</div>
}

// ---------------------------------------------------------------------------
// Camera Mode Card
// ---------------------------------------------------------------------------
templ cameraModeCard(mode string, endpoint string, name string, desc string, shortcut string, active bool, enabled bool) {
	<button
		class={ "mode-card", "mode-" + mode, templ.KV("active", active) }
		data-on:click={ fmt.Sprintf("@post('%s')", endpoint) }
		data-indicator="loading"
		data-class:btn-loading="$loading"
		aria-label={ name }
		if active {
			aria-current="true"
		}
		if !enabled {
			disabled=""
		}
	>
		<div class="mode-icon-wrap">
			if mode == "track" {
				@iconTarget()
			} else if mode == "idle" {
				@iconStandby()
			} else if mode == "privacy" {
				@iconEyeOff()
			}
		</div>
		<span class="mode-name">{ name }</span>
		<span class="mode-desc">{ desc }</span>
		<span class="kbd mode-kbd">{ shortcut }</span>
	</button>
}

// ---------------------------------------------------------------------------
// Audio Segment (segmented control button)
// ---------------------------------------------------------------------------
templ audioSegment(mode string, label string, active bool, enabled bool) {
	<button
		class={ "segment", templ.KV("active", active) }
		data-on:click={ fmt.Sprintf("@post('/api/audio/%s')", mode) }
		data-indicator="loading"
		data-class:btn-loading="$loading"
		aria-label={ label }
		if !enabled {
			disabled=""
		}
	>
		{ label }
	</button>
}

templ trackingSegment(variant, label string, active bool) {
	<button
		class={ "segment", templ.KV("active", active) }
		data-on:click={ fmt.Sprintf("@post('/api/tracking/%s')", variant) }
		data-indicator="loading"
		data-class:btn-loading="$loading"
	>
		{ label }
	</button>
}

// ---------------------------------------------------------------------------
// PTZ Radar — reactive to $pan/$tilt/$zoom signals via data-style.
// Server-rendered inline style provides correct initial render before
// DataStar evaluates the expressions (eliminates FOUC at position 0,0).
// ---------------------------------------------------------------------------
templ ptzRadar(pan int, tilt int, zoom int) {
	<div
		class="ptz-radar"
		style={ fmt.Sprintf("--pan-x: %.1f%%; --pan-y: %.1f%%; --zoom-pct: %.1f%%",
			float64(pan+150)/300*100,
			float64(90-tilt)/180*100,
			float64(zoom-100)/50*100) }
		data-style:--pan-x="(($pan + 150) / 300 * 100) + '%'"
		data-style:--pan-y="((90 - $tilt) / 180 * 100) + '%'"
		data-style:--zoom-pct="(($zoom - 100) / 50 * 100) + '%'"
	>
		<div class="ptz-radar-ring"></div>
		<div class="ptz-radar-zoom-ring"></div>
		<div class="ptz-radar-center"></div>
		<div class="ptz-radar-field">
			<div class="ptz-radar-dot"></div>
		</div>
	</div>
}

// ---------------------------------------------------------------------------
// Preset Section (save input + preset chips)
// ---------------------------------------------------------------------------
templ presetSection(names []string) {
	<div class="preset-section">
		<div class="preset-header">
			<span class="preset-label" data-i18n="presets.title">Presets</span>
			<div class="preset-header-right">
				if len(names) > 0 {
					<span class="preset-count">{ fmt.Sprintf("%d/%d", len(names), pixy.MaxPresets) }</span>
				}
				<button
					class="btn btn-small preset-pull-btn"
					type="button"
					aria-label="Pull presets from camera hardware slots"
					title="Pull hardware motor slots into presets (read-only)"
					data-on:click="@post('/api/preset/pull')"
					data-i18n="presets.pull"
				>Pull</button>
			</div>
		</div>
		<div class="preset-save-row">
			<input
				type="text"
				class="preset-input"
				id="preset-name-input"
				aria-label="Preset name"
				aria-describedby="preset-name-help"
				placeholder="Save current position\u2026"
				maxlength="32"
				autocomplete="off"
				list="preset-names-list"
				data-bind="presetName"
				data-on:keydown="evt.key === 'Enter' && document.getElementById('preset-save-btn').click()"
				data-i18n-placeholder="presets.placeholder"
			/>
			<button
				class="btn btn-small"
				id="preset-save-btn"
				type="button"
				aria-label="Save preset"
				data-on:click="$presetName.trim() ? (@post('/api/preset/save/' + encodeURIComponent($presetName.trim())), $presetName = '') : window.__showToast(window.__i18n('presets.emptyNameError'), 'error')"
				data-i18n="presets.save"
			>Save</button>
		</div>
		<p class="preset-hint" id="preset-name-help" data-i18n="presets.hint">Ingresá un nombre para guardar la posición actual; podés usar espacios.</p>
		if len(names) > 0 {
			<datalist id="preset-names-list">
				for _, name := range names {
					<option value={ name }></option>
				}
			</datalist>
			<div class="preset-chips">
				for _, name := range names {
					@presetChip(name)
				}
			</div>
		}
	</div>
}

templ presetChip(name string) {
	<div class="preset-chip">
		<button
			class="preset-chip-load"
			data-on:click={ fmt.Sprintf("@post('/api/preset/load/' + encodeURIComponent(%s))", strconv.Quote(name)) }
			aria-label={ fmt.Sprintf("Load preset %s", name) }
		>
			{ name }
		</button>
		<button
			class="preset-chip-push"
			data-on:click={ fmt.Sprintf("@post('/api/preset/push/' + encodeURIComponent(%s))", strconv.Quote(name)) }
			aria-label={ fmt.Sprintf("Apply preset %s to camera immediately", name) }
			title="Apply immediately: moves the camera and attempts to write its hardware preset slot"
		>
			@iconPush()
		</button>
		<button
			class="preset-chip-delete"
			data-on:click={ fmt.Sprintf("@post('/api/preset/delete/' + encodeURIComponent(%s))", strconv.Quote(name)) }
			aria-label={ fmt.Sprintf("Delete preset %s", name) }
		>
			&times;
		</button>
	</div>
}

// ---------------------------------------------------------------------------
// Route Section ("Modo recorrido") — record/save/play motion routes.
// Route controls use DataStar actions so every action returns a server-rendered
// route section patch. Loop and ping-pong are selectable in the UI.
// ---------------------------------------------------------------------------
templ routeSection(s webStatus) {
	<div class="route-section" id="route-section">
		<div class="route-header">
			<span class="route-label" data-i18n="route.title">Modo recorrido</span>
			if len(s.Routes) > 0 {
				<span class="preset-count">{ fmt.Sprintf("%d/%d", len(s.Routes), pixy.MaxRoutes) }</span>
			}
		</div>
		if s.PlayingRoute != "" {
			<div class="route-status route-status-playing" id="route-status-playing">
				<span class="route-live-dot"></span>
				<span data-i18n="route.playingLabel">Reproduciendo</span>:
				<strong>{ s.PlayingRoute }</strong>
				<button class="btn btn-small" id="route-stop-btn" type="button" data-on:click="@post('/api/route/stop')" data-i18n="route.stop">Detener</button>
			</div>
		} else if s.RecordingRoute {
			<div class="route-status route-status-recording" id="route-status-recording">
				<span class="route-rec-dot"></span>
				<span data-i18n="route.recordingLabel">Grabando</span>
				<span class="badge-mini" id="route-recording-count">{ fmt.Sprintf("%d", s.RecordingSteps) }</span>
				<button class="btn btn-small" id="route-record-stop-btn" type="button" data-on:click="@post('/api/route/record/stop')" data-i18n="route.stopRecording">Detener grabación</button>
			</div>
		} else if s.PendingRouteSteps > 0 {
			<div class="route-save-row">
				<input
					type="text"
					class="preset-input"
					id="route-name-input"
					aria-label="Route name"
					maxlength="32"
					autocomplete="off"
					data-on:keydown="evt.key === 'Enter' && document.getElementById('route-save-btn').click()"
					data-i18n-placeholder="route.namePlaceholder"
					placeholder="Nombre del recorrido…"
				/>
				<button class="btn btn-small" id="route-save-btn" type="button" data-on:click="document.getElementById('route-name-input').value.trim() ? (@post('/api/route/save/' + encodeURIComponent(document.getElementById('route-name-input').value.trim()))) : window.__showToast(window.__i18n('route.nameRequired'), 'error')" data-i18n="route.save">Guardar</button>
				<button class="btn btn-small btn-ghost" id="route-discard-btn" type="button" data-on:click="@post('/api/route/record/discard')" data-i18n="route.discard">Descartar</button>
			</div>
			<p class="preset-hint" id="route-pending-hint">
				<span id="route-pending-count">{ fmt.Sprintf("%d", s.PendingRouteSteps) }</span>
				<span data-i18n="route.pendingHint">pasos capturados — asignale un nombre para guardarlo.</span>
			</p>
		} else if s.RouteBusy {
			<p class="route-status route-status-playing" role="status" data-i18n="route.finishing">Finalizando recorrido y restaurando el seguimiento…</p>
		} else {
			<button class="btn btn-small" id="route-record-start-btn" type="button" data-on:click="@post('/api/route/record/start')" data-i18n="route.start">Grabar recorrido</button>
		}
		if len(s.Routes) > 0 {
			<div class="route-options" role="group" aria-label="Opciones de reproducción">
				<label><input id="route-loop" type="checkbox"/> <span data-i18n="route.loop">Repetir</span></label>
				<label><input id="route-pingpong" type="checkbox"/> <span data-i18n="route.pingPong">Ida y vuelta</span></label>
			</div>
			<div class="route-chips">
				for _, name := range s.Routes {
					@routeChip(name)
				}
			</div>
		} else {
			<p class="route-empty" data-i18n="route.empty">Todavía no hay recorridos guardados. Aparecerán aquí.</p>
		}
	</div>
}

templ routeChip(name string) {
	<div class="preset-chip route-chip">
		<button
			class="preset-chip-load route-chip-play"
			type="button"
			data-route-name={ name }
			data-on:click={ fmt.Sprintf("@post('/api/route/play/' + encodeURIComponent(%s) + '?loop=' + document.getElementById('route-loop').checked + '&pingpong=' + document.getElementById('route-pingpong').checked)", strconv.Quote(name)) }
			aria-label={ fmt.Sprintf("Play route %s", name) }
		>
			{ name }
		</button>
		<button
			class="preset-chip-delete route-chip-delete"
			type="button"
			data-route-name={ name }
			data-on:click={ fmt.Sprintf("@post('/api/route/delete/' + encodeURIComponent(%s))", strconv.Quote(name)) }
			aria-label={ fmt.Sprintf("Delete route %s", name) }
		>
			&times;
		</button>
	</div>
}

// ---------------------------------------------------------------------------
// PTZ Slider — data-on:input sets signal as number, debounced @post to server.
// Value display is reactive via data-text referencing the signal.
// ---------------------------------------------------------------------------
templ ptzSlider(label, axis string, min, max, value int, unit string) {
	<div class="slider-row" id={ "ptz-" + axis }>
		<span class="slider-label">{ label }</span>
		<input
			type="range"
			class="ptz-slider"
			id={ "slider-" + axis }
			min={ fmt.Sprintf("%d", min) }
			max={ fmt.Sprintf("%d", max) }
			value={ fmt.Sprintf("%d", value) }
			data-bind={ axis }
			data-on:input={ fmt.Sprintf("$%s = Number(evt.target.value)", axis) }
			data-on:input__debounce.300ms={ fmt.Sprintf("@post('/api/ptz/%s')", axis) }
		/>
		<span class="slider-value" id={ "val-" + axis } data-text={ fmt.Sprintf("$%s + '%s'", axis, unit) }>{ fmt.Sprintf("%d%s", value, unit) }</span>
	</div>
}

// ---------------------------------------------------------------------------
// Keyboard Shortcut Legend
// ---------------------------------------------------------------------------
templ shortcutLegend() {
	<aside class="shortcut-legend" id="shortcut-legend" hidden>
		<div class="legend-header">
			<span class="legend-title">Shortcuts</span>
			<button class="legend-close" id="legend-close" type="button" aria-label="Close shortcuts">&times;</button>
		</div>
		<div class="legend-list">
			<div class="legend-row"><kbd>T</kbd><span>Track</span></div>
			<div class="legend-row"><kbd>I</kbd><span>Idle</span></div>
			<div class="legend-row"><kbd>P</kbd><span>Privacy</span></div>
			<div class="legend-row"><kbd>C</kbd><span>Center</span></div>
			<div class="legend-row"><kbd>&larr;</kbd><kbd>&rarr;</kbd><span>Pan</span></div>
			<div class="legend-row"><kbd>&uarr;</kbd><kbd>&darr;</kbd><span>Tilt</span></div>
			<div class="legend-row"><kbd>+</kbd><kbd>&minus;</kbd><span>Zoom</span></div>
			<div class="legend-row"><kbd>?</kbd><span>This help</span></div>
		</div>
	</aside>
}

// ---------------------------------------------------------------------------
// Motor Speed Sliders
// ---------------------------------------------------------------------------

// speedSlider renders one motor-speed row (0..100 sanity scale, transmitted
// verbatim to the official V2 SetMotorSpeed command). The initial value is
// the persisted speed (0 = no preference) — the real hardware limit and unit
// stay unknown until the hardware session pins the GetMotorSpeed response
// framing, so the value display carries no unit claim.
templ speedSlider(label, axis, signal, value string) {
	<div class="slider-row" id={ "speed-" + axis }>
		<span class="slider-label">{ label }</span>
		<input
			type="range"
			class="ptz-slider speed-slider"
			id={ "speed-slider-" + axis }
			min="0"
			max="100"
			step="1"
			value={ value }
			data-bind={ signal }
			data-on:input={ fmt.Sprintf("$%s = Number(evt.target.value)", signal) }
			data-on:input__debounce.300ms={ fmt.Sprintf("@post('/api/speed/%s')", axis) }
		/>
		<span class="slider-value" id={ "speed-val-" + axis } data-text={ fmt.Sprintf("$%s", signal) }>{ value }</span>
	</div>
}
