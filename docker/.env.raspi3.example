# Raspberry Pi 3 Model B/B+ running 32-bit Raspberry Pi OS (linux/arm/v7).
# Confirm the actual nodes and groups on the host before starting Compose.
PIXY_VIDEO_DEVICE=/dev/video0
PIXY_VIDEO_CONTAINER_DEVICE=/dev/video0
PIXY_HIDRAW_DEVICE=/dev/hidraw0
PIXY_HIDRAW_CONTAINER_DEVICE=/dev/hidraw0
PIXY_AUDIO_CONTROL_DEVICE=/dev/snd/controlC2
PIXY_AUDIO_CONTROL_CONTAINER_DEVICE=/dev/snd/controlC2
PIXY_AUDIO_PCM_DEVICE=/dev/snd/pcmC2D0c
PIXY_AUDIO_PCM_CONTAINER_DEVICE=/dev/snd/pcmC2D0c

PIXY_VIDEO_GID=44
PIXY_HIDRAW_GID=46
PIXY_AUDIO_GID=29
PIXY_UID=1000
PIXY_GID=1000
PIXY_STATE_DIR=./data

PIXY_WEB_PORT=18090
EMEET_PIXYD_AUTO=off
EMEET_PIXYD_DEFAULT_AUDIO=nc
EMEET_PIXYD_DEBUG=false
INSTALL_DESKTOP_TOOLS=0
# LAN IP of the neuralVISION host that runs MediaMTX, for RTSP hostname `nv`.
RTSP_HOST_IP=192.168.195.33
IMAGE_TAG=latest
