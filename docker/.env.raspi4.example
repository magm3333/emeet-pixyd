# Device nodes discovered on pi@raspi4 (EMEET PIXY USB 328f:00c0).
PIXY_VIDEO_DEVICE=/dev/video0
PIXY_VIDEO_CONTAINER_DEVICE=/dev/video0
PIXY_HIDRAW_DEVICE=/dev/hidraw0
PIXY_HIDRAW_CONTAINER_DEVICE=/dev/hidraw0
PIXY_AUDIO_CONTROL_DEVICE=/dev/snd/controlC3
PIXY_AUDIO_CONTROL_CONTAINER_DEVICE=/dev/snd/controlC3
PIXY_AUDIO_PCM_DEVICE=/dev/snd/pcmC3D0c
PIXY_AUDIO_PCM_CONTAINER_DEVICE=/dev/snd/pcmC3D0c

# The udev rule assigns video nodes to `video` and hidraw to `plugdev`.
# ALSA capture nodes belong to the `audio` group (GID 29).
PIXY_VIDEO_GID=44
PIXY_HIDRAW_GID=46
PIXY_AUDIO_GID=29
PIXY_UID=1000
PIXY_GID=1000
PIXY_STATE_DIR=./data

PIXY_WEB_PORT=18090
EMEET_PIXYD_AUTO=off
EMEET_PIXYD_DEFAULT_AUDIO=nc
EMEET_PIXYD_DEBUG=false
INSTALL_DESKTOP_TOOLS=0
# LAN IP of the neuralVISION host that runs MediaMTX, for RTSP URL host `nv`.
RTSP_HOST_IP=192.168.195.33
IMAGE_TAG=latest
IMAGE_VERSION=dev
