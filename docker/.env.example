# Device nodes on the Linux host. Find them with:
#   v4l2-ctl --list-devices
#   ls -l /dev/video* /dev/hidraw*
PIXY_VIDEO_DEVICE=/dev/video0
PIXY_VIDEO_CONTAINER_DEVICE=/dev/video0
PIXY_HIDRAW_DEVICE=/dev/hidraw4
PIXY_HIDRAW_CONTAINER_DEVICE=/dev/hidraw4

# Supplementary group IDs from the HOST's device-node ownership.
# Find them with: stat -c '%g %n' /dev/video0 /dev/hidraw4
PIXY_VIDEO_GID=44
PIXY_HIDRAW_GID=46

# Keep the runtime unprivileged and use the host account so the bind-mounted
# state directory and host camera nodes have matching ownership.
PIXY_UID=1000
PIXY_GID=1000
PIXY_STATE_DIR=./data

# Published on all IPv4 interfaces for LAN access. The API has no authentication.
PIXY_WEB_PORT=18090

# Docker defaults to manual mode. Call detection and host PipeWire switching
# require additional host PID/session integration; see docker/README.md.
EMEET_PIXYD_AUTO=off
EMEET_PIXYD_DEFAULT_AUDIO=nc
EMEET_PIXYD_DEBUG=false
INSTALL_DESKTOP_TOOLS=0

IMAGE_TAG=latest
IMAGE_VERSION=dev
